---
const steps = [
  { n: '01', title: 'Розмова', text: '30 хвилин: що болить, що вже пробували, які дані є.', badge: 'Безкоштовно' },
  { n: '02', title: 'Діагностика', text: 'Дивимося всю систему: канали, витрати, CRM, аналітику, пропозицію. Кажемо, де ґандж і скільки він коштує.', badge: 'Карта ґанджів' },
  { n: '03', title: 'База', text: 'Основне лагодимо самі: трекінг, джерела заявок у CRM, ключові сторінки, пропозицію.', badge: 'Робоча основа' },
  { n: '04', title: 'Свої люди', text: 'Де потрібен вузький спеціаліст (SEO, PPC, PR), підключаємо перевірених і стежимо за роботою.', badge: 'Команда' },
  { n: '05', title: 'Супровід', text: 'Щомісяця дивимося на цифри й вирішуємо, що далі: куди долити, що зупинити.', badge: 'Контроль цифр' },
];
---
<div class="process-grid process-grid--5">
  {steps.map((s) => (
    <div class="process-step">
      <div>
        <div class="step-number">{s.n}</div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
      <span class="step-badge">{s.badge}</span>
    </div>
  ))}
</div>
