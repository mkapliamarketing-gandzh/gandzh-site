---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CaseCard from '../components/CaseCard.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const stages = [
  {
    num: 'ЕТАП // 01',
    term: 'Безкоштовно, 30 хв',
    title: 'Розмова',
    text: 'Що болить, що вже пробували, які дані є. Після неї зрозуміло, чи ми взагалі вам потрібні.',
    list: ['Ваші цілі й обмеження', 'Що вже працює, а що бісить', 'Які доступи знадобляться'],
  },
  {
    num: 'ЕТАП // 02',
    term: 'Діагностика',
    title: 'Пошук ґанджу',
    img: { src: '/media/07-audit-still.webp', alt: 'Колаж: лупа над червоною тріщиною', fx: 'fx-audit' },
    text: 'Канали, витрати, CRM, аналітика, сайт, пропозиція. На виході короткий документ: що працює, що протікає, що зробити першим.',
    list: [
      'Кожна рекомендація має дані, на яких вона стоїть',
      'І умову, за якої вона хибна',
      'Пріоритети: що лагодити зараз, а що почекає',
    ],
  },
  {
    num: 'ЕТАП // 03',
    term: 'Робимо самі',
    title: 'База',
    img: { src: '/media/08-system-still.webp', alt: 'Колаж: червоний ящик з інструментами', fx: 'fx-system' },
    text: 'Лагодимо основне без зносу того, що працює.',
    list: ['Трекінг і справжні бізнес-події', 'Джерела заявок і поля в CRM', 'Ключові сторінки й пропозиція'],
  },
  {
    num: 'ЕТАП // 04',
    term: 'Перевірені люди',
    title: 'Команда',
    img: { src: '/media/10-strategy-still.webp', alt: 'Колаж: компас із червоною стрілкою', fx: 'fx-strategy' },
    text: 'Під конкретні задачі підключаємо спеціалістів, яким довіряємо: SEO, PPC, PR та інших.',
    list: ['Зрозумілі ТЗ замість «зробіть щось віральне»', 'Перевірка роботи за результатом', 'Вам не треба гадати, кому вірити'],
  },
  {
    num: 'ЕТАП // 05',
    term: 'Щомісяця',
    title: 'Супровід',
    img: { src: '/media/09-analytics-still.webp', alt: 'Колаж: стрілка аналогового приладу в жовтій зоні', fx: 'fx-analytics' },
    text: 'Дивимося на цифри й ухвалюємо рішення разом з вами, як маркетинг-лід у команді.',
    list: ['Перегляд цифр і бюджету', 'Рішення: долити, зупинити, перекинути', 'Керування підрядниками'],
  },
];
---
<Base
  title="Маркетинг-лід на частину часу (fractional CMO) — Ґандж"
  description="Розбираємося, що вже є у вашому маркетингу, лагодимо основне і відповідаємо за рішення далі. Fractional CMO для B2B-компаній, яким ще рано наймати CMO на повну ставку."
>
  <PageHero
    tag="Основна послуга"
    title="Маркетинг-лід на частину часу"
    lead="Вам не потрібна велика агенція зі стратегією за $25K, яка ляже в шухляду. І ще не потрібен штатний CMO на повну ставку. Потрібна людина, яка розбереться, що вже є, полагодить основне і відповідатиме за рішення далі."
    cta="Розповісти про свій ґандж →"
  />

  <section class="fit-section">
    <div class="container fit-grid">
      <div class="fit-card">
        <h2>Кому підходить</h2>
        <ul>
          <li>У вас B2B-компанія, яка вже витрачає на маркетинг: підрядники, реклама, платформи.</li>
          <li>Рішення про маркетингові гроші досі ухвалює CEO або засновник, бо більше нікому.</li>
          <li>Ви не можете сказати, який канал приводить клієнтів, що платять.</li>
        </ul>
      </div>
      <div class="fit-card fit-card--no">
        <h2>Кому не підходить</h2>
        <ul>
          <li>Маркетингу ще немає зовсім, і бюджету теж. Тоді почнемо з однієї консультації, а не з супроводу.</li>
          <li>Потрібні руки на щоденні пости й рекламу. Ми керуємо й лагодимо, а не замінюємо SMM-ника.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="services-section" id="stages">
    <div class="container">
      <div class="section-tag">Етапи</div>
      <h2 class="section-title">Від розмови до супроводу</h2>
      <p class="section-lead">Діагностика — лише перший крок. Ми не лишаємо вас сам на сам зі звітом.</p>
      <div class="services-grid">
        {stages.map((s) => (
          <article class={s.img ? "service-card" : "service-card service-card--wide"}>
            <div>
              {s.img && (
                <div class={`service-media ${s.img.fx}`}>
                  <img src={s.img.src} alt={s.img.alt} loading="lazy" width="560" height="560" />
                </div>
              )}
              <div class="service-meta">
                <span class="service-num">{s.num}</span>
                <span class="service-term">{s.term}</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
            <ul class="service-list">
              {s.list.map((li) => <li>{li}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="prose-section">
    <div class="container narrow">
      <div class="section-tag">Формат і вартість</div>
      <h2 class="section-title">Скільки це коштує</h2>
      <p>Формат і вартість залежать від розміру вашого маркетингу. Називаємо їх після першої розмови, без «від $…» дрібним шрифтом.</p>

      <h2 class="section-title qa-title">А чим це краще за ChatGPT?</h2>
      <p>ШІ чудово рахує те, що ви йому дасте. Проблема в тому, що в більшості компаній даних, які можна дати, немає, або вони суперечать одне одному. Ми теж користуємося ШІ, але кожну цифру перевіряємо і відповідаємо за рекомендацію, а не перекладаємо її на модель.</p>
    </div>
  </section>

  <section class="cases-section">
    <div class="container">
      <div class="section-tag">Докази</div>
      <h2 class="section-title">Як це виглядає на практиці</h2>
      <div class="cases-grid">
        {cases.map((entry, i) => <CaseCard entry={entry} index={i} />)}
      </div>
      <p class="section-more"><a class="text-link" href="/keisy/">Усі кейси →</a></p>
    </div>
  </section>
</Base>
