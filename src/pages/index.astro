---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import Steps from '../components/Steps.astro';
import { defects } from '../data/defects';

const featured = (await getCollection('cases', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const reasons = [
  {
    code: '#01',
    title: '«Платимо підряднику, а що отримуємо — не знаємо»',
    text: 'Агенція звітує кліками й охопленнями, фрилансер каже «алгоритм вчиться». Перевіримо незалежно: кабінети, трекінг і чи доходять заявки до грошей.',
    link: { href: '/tekhohliad-pidriadnyka/', label: 'Техогляд підрядника →' },
  },
  {
    code: '#02',
    title: '«Куди долити, а звідки зняти?»',
    text: 'Бюджет розкиданий по каналах, і кожен «щось дає». Покажемо, що з цього приводить потрібних клієнтів, а що просто з’їдає гроші.',
    link: { href: '/yak-pratsiuiemo/', label: 'Як працюємо →' },
  },
  {
    code: '#03',
    title: '«Клієнти тільки з рекомендацій і Upwork»',
    text: 'Поки знайомі рекомендують, усе добре. Коли перестають, бізнес стартує з нуля щомісяця. Знайдемо, що можна побудувати своє.',
    link: { href: '/yak-pratsiuiemo/', label: 'Як працюємо →' },
  },
];

const marquee = [
  'CRM ДЛЯ ГАЛОЧКИ',
  'САЙТ, ЩО НЕ ПРОДАЄ',
  'ЛІДИ З НІЗВІДКИ',
  'ПІДРЯДНИКИ У РІЗНІ БОКИ',
  'КОНТЕНТ ЗАРАДИ КОНТЕНТУ',
  'РЕКЛАМА «ЩОСЬ ТАМ КРУТИТЬСЯ»',
];

const nodes = [
  { title: 'Реклама', before: '⚠ «Щось там крутиться»', after: '✓ Оптимізація під заявки, що доходять до грошей' },
  { title: 'Сайт / лендинг', before: '⚠ Трафік є, заявок нема', after: '✓ Зрозуміло, що ви продаєте і кому' },
  { title: 'CRM', before: '⚠ Джерело заявки «десь записано»', after: '✓ Джерело й етап у кожній заявці' },
  { title: 'Аналітика', before: '⚠ «Звідки клієнт?» — таємниця', after: '✓ Видно, який канал приводить клієнтів' },
];
---
<Base
  title="Ґандж — маркетинг-лід на частину часу для B2B"
  description="Знаходимо, де у вашому маркетингу протікають гроші, лагодимо основне і ведемо далі. Для B2B-компаній, які вже платять за маркетинг, але не розуміють, що з того працює."
>
  <div class="loader" id="loader" role="status" aria-live="polite" hidden>
    <div class="dict">
      <span class="dict-tab">Словник</span>
      <div class="dict-word"><b>Ґ</b>андж</div>
      <div class="dict-pos">/ґа́ндж/ · іменник, чоловічий рід</div>
      <div class="dict-def"><i>1.</i>Дефект, хиба, вада.</div>
    </div>
    <div class="seek">
      <div class="seek-main">Шукаємо ґанджі<span class="dots"><span>.</span><span>.</span><span>.</span></span></div>
      <div class="seek-phrase" id="seekPhrase"></div>
    </div>
  </div>

  <!-- ХІРО -->
  <section class="hero">
    <div class="container">
      <div class="hero-meta-bar">
        <div class="status-pill">
          <span class="status-dot"></span>
          ДІАГНОСТИКА → РЕМОНТ → СУПРОВІД
        </div>
        <div>[ МАРКЕТИНГ, ЩО ГОВОРИТЬ ГРОШИМА ]</div>
      </div>

      <div class="hero-grid">
        <div>
          <div class="brand-wrap" id="brandWrap">
            <div class="hero-brand" id="heroBrand" aria-hidden="true"><span class="letter-g">Ґ</span>АНДЖ</div>
          </div>
          <div class="dict-row"><span class="dict-note">/іменник/ — дефект, хиба, вада</span></div>

          <h1 class="hero-slogan">У кожного маркетингу є ґандж. Ми знаємо, де шукати.</h1>

          <p class="hero-sub">
            Гроші на маркетинг уже йдуть: підрядники, реклама, Clutch, CRM. А рішення «продовжувати, зупинити чи перекинути бюджет» досі висить на вас. Ми беремо його на себе: знаходимо, де протікає, лагодимо основне і ведемо маркетинг далі як ваш маркетинг-лід на частину часу.
          </p>

          <div class="hero-actions">
            <a href="#contact" class="btn btn-primary">Показати свій ґандж →</a>
            <span class="hero-note">Без презентацій на 40 сторінок. Діагноз, план ремонту і хтось, хто за нього відповідає.</span>
          </div>
        </div>

        <div class="diagnostic-box">
          <div class="diag-header">
            <span class="diag-title">Схема вашої воронки</span>
            <div class="diag-switch" role="group" aria-label="Режим перегляду">
              <button type="button" class="active" data-mode="before" aria-pressed="true">Зараз</button>
              <button type="button" data-mode="after" aria-pressed="false">Як має бути</button>
            </div>
          </div>

          <div class="diag-canvas" id="diagCanvas">
            <div class="diag-nodes">
              {nodes.map((n) => (
                <div class="diag-node" data-before={n.before} data-after={n.after}>
                  <strong>{n.title}</strong>
                  <span>{n.before}</span>
                </div>
              ))}
            </div>

            <div class="diag-footer">
              <span>СТАН СИСТЕМИ:</span>
              <span class="diag-verdict" id="diagVerdict">ПІДТІКАЄ НА КОЖНОМУ СТИКУ</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      {[...marquee, ...marquee].map((m) => (
        <>
          <span>{m}</span><span class="marquee-sep">///</span>
        </>
      ))}
    </div>
  </div>

  <!-- ПРИВОДИ НАПИСАТИ -->
  <section class="reasons-section" id="reasons">
    <div class="container">
      <div class="section-tag">Приводи написати</div>
      <h2 class="section-title">З чим до нас приходять</h2>
      <div class="reasons-grid">
        {reasons.map((r) => (
          <article class="reason-card">
            <span class="defect-code">ҐАНДЖ {r.code}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <a class="text-link" href={r.link.href}>{r.link.label}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- СИМПТОМИ -->
  <section class="defects-section" id="defects">
    <div class="container">
      <div class="section-header-split">
        <div>
          <div class="section-tag">Симптоми</div>
          <h2 class="section-title">Знайомі ґанджі</h2>
          <p class="section-lead">
            Якщо впізнали хоча б два пункти, ваш маркетинг не помер, йому просто потрібен чесний майстер. Клікніть на ті, що болять, і вони потраплять у заявку.
          </p>
        </div>

        <div class="defect-counter-box" aria-live="polite">
          <div class="defect-counter-top">
            <span>Ваш діагноз зараз</span>
            <span class="defect-counter-score" id="defectScore">0 / 6 ґанджів</span>
          </div>
          <div class="defect-counter-msg" id="defectMsg">
            Відмічайте картки — підрахуємо масштаб лиха і передамо в заявку.
          </div>
        </div>
      </div>

      <div class="defects-grid">
        {defects.map((d, i) => (
          <article class="defect-card" data-defect={d.title} tabindex="0" role="checkbox" aria-checked="false">
            <div>
              <div class="defect-top">
                <span class="defect-code">ҐАНДЖ #{String(i + 1).padStart(2, '0')}</span>
                <span class="defect-check">
                  <span class="defect-checkbox-ui"></span>
                  <span>Це про нас</span>
                </span>
              </div>
              <div class="defect-media" style={`background:${d.bg}`}>
                <video class="lazy-vid" muted loop playsinline preload="none" poster={`/media/${d.media}.webp`} data-src={`/media/${d.media}.mp4`} aria-label={d.alt}></video>
              </div>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
            </div>
            <div class="defect-symptom-quote"><span>Типова відмазка:</span> {d.excuse}</div>
          </article>
        ))}
      </div>
    </div>
    <div class="diag-float" id="diagFloat" aria-hidden="true">
      <div class="diag-float-top">
        <span class="diag-float-label">Ваш діагноз зараз</span>
        <span class="diag-float-score" id="floatScore">0 / 6 ґанджів</span>
      </div>
      <div class="diag-float-msg" id="floatMsg">Відмічайте картки — підрахуємо масштаб лиха і передамо в заявку.</div>
      <a href="#contact" class="diag-float-cta" tabindex="-1">Передати в заявку →</a>
    </div>
  </section>

  <!-- ЯК ПРАЦЮЄМО -->
  <section class="process-section" id="process">
    <div class="container">
      <div class="section-tag">Процес</div>
      <h2 class="section-title">Як ми працюємо</h2>
      <p class="section-lead">
        Не разовий аудит, після якого ви лишаєтесь сам на сам із PDF. Діагноз — це тільки перший крок, далі лагодимо і ведемо.
      </p>
      <Steps />
      <p class="section-more"><a class="text-link" href="/yak-pratsiuiemo/">Детально про формат →</a></p>
    </div>
  </section>

  <!-- КЕЙСИ -->
  <section class="cases-section" id="cases">
    <div class="container">
      <div class="section-tag">Докази</div>
      <h2 class="section-title">Ґанджі, які ми вже знаходили</h2>
      <p class="section-lead">
        Кейси з практики засновниці на посаді маркетинг-ліда. Назви компаній не розкриваємо, а межі результату чесно підписуємо.
      </p>
      <div class="cases-grid cases-grid--2">
        {featured.map((entry, i) => <CaseCard entry={entry} index={i} />)}
      </div>
      <p class="section-more"><a class="text-link" href="/keisy/">Усі кейси →</a></p>
    </div>
  </section>

  <!-- ХТО ЗА ЦИМ СТОЇТЬ -->
  <section class="about-mini">
    <div class="container about-mini-grid">
      <div>
        <div class="section-tag">Хто за цим стоїть</div>
        <h2 class="section-title">Маргарита Капля</h2>
      </div>
      <div class="about-mini-text">
        <p>Була CMO і маркетинг-лідом у B2B-компаніях, які продають на західні ринки. Будувала маркетинг з нуля: аналітику, атрибуцію, CRM, позиціонування.</p>
        <p>Про мене колись сказали «скоріше робоча конячка, аніж breakthrough маркетолог». Так і є.</p>
        <a class="text-link" href="/pro-mene/">Детальніше →</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Ефект «зсуву друку» на назві
  const brand = document.getElementById('heroBrand');
  const brandWrap = document.getElementById('brandWrap');
  function misprint(intensity: number) {
    if (reduce || !brand || !brandWrap) return;
    brandWrap.querySelectorAll('.misprint').forEach((n) => n.remove());
    const html = brand.innerHTML;
    const layers = [
      { cls: 'red', dx: [-26, 18, -12, 8, -4, 0], dy: [6, -4, 3, -2, 1, 0] },
      { cls: 'volt', dx: [22, -16, 10, -6, 3, 0], dy: [-5, 3, -2, 1, 0, 0] },
      { cls: 'ink', dx: [14, -20, 9, -5, 2, 0], dy: [3, 2, -2, 1, 0, 0] },
    ];
    const bands = 6;
    layers.forEach((L, li) => {
      for (let b = 0; b < bands; b++) {
        const el = document.createElement('div');
        el.className = 'hero-brand misprint ' + L.cls;
        el.setAttribute('aria-hidden', 'true');
        el.innerHTML = html;
        el.querySelectorAll<HTMLElement>('.letter-g').forEach((g) => (g.style.color = 'inherit'));
        el.style.clipPath = `inset(${(100 / bands) * b}% 0 ${100 - (100 / bands) * (b + 1)}% 0)`;
        brandWrap.appendChild(el);
        const j = () => (Math.random() * 1.6 - 0.3) * intensity;
        el.animate(
          L.dx.map((dx, i) => ({
            transform: `translate(${(dx * j()).toFixed(1)}px, ${(L.dy[i] * intensity).toFixed(1)}px)`,
            opacity: i === L.dx.length - 1 ? 0 : li === 2 ? 0.9 : 0.85,
          })),
          { duration: 900 + b * 40, delay: li * 40, easing: 'steps(6, end)', fill: 'forwards' },
        ).onfinish = () => el.remove();
      }
    });
    brand.animate(
      [{ transform: 'translate(3px,-1px)' }, { transform: 'translate(-2px,1px)' }, { transform: 'translate(1px,0)' }, { transform: 'none' }],
      { duration: 500, easing: 'steps(4,end)' },
    );
  }
  brand?.addEventListener('mouseenter', () => misprint(0.45));

  // Заставка-словник: лише при першому візиті за сесію
  (function () {
    const loader = document.getElementById('loader');
    const phraseEl = document.getElementById('seekPhrase');
    if (!loader || !phraseEl) return;
    let seen = false;
    try { seen = sessionStorage.getItem('gandzh-loader') === '1'; sessionStorage.setItem('gandzh-loader', '1'); } catch {}
    if (seen || reduce) { setTimeout(() => misprint(1), 200); return; }
    const phrases = ['Відкриваємо CRM… ой.', 'Рахуємо UTM-мітки. Їх нуль.', 'Питаємо, звідки ліди…', 'Читаємо звіт підрядника…', 'Шукаємо, куди подівся бюджет…', 'Розплутуємо підрядників…', 'Дістаємо ізоленту…'];
    const a = phrases.slice();
    for (let i = a.length - 1; i > 0; i--) { const k = Math.floor(Math.random() * (i + 1)); [a[i], a[k]] = [a[k], a[i]]; }
    const seq = a.slice(0, 3).concat('Знайшли. Ну звісно.');
    loader.hidden = false;
    document.body.classList.add('loading');
    const step = 480;
    seq.forEach((t, i) => setTimeout(() => {
      phraseEl.innerHTML = '';
      const sp = document.createElement('span');
      sp.textContent = t;
      phraseEl.appendChild(sp);
    }, 200 + i * step));
    setTimeout(() => {
      loader.classList.add('out');
      document.body.classList.remove('loading');
      setTimeout(() => misprint(1), 250);
    }, 200 + seq.length * step + 350);
  })();

  // Відео: на hover на десктопі, при появі в кадрі на тач-екранах
  (function () {
    const vids = document.querySelectorAll<HTMLVideoElement & { _loading?: Promise<void>; _want?: boolean }>('video.lazy-vid');
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    function load(v: (typeof vids)[number]) {
      if (v._loading) return v._loading;
      v.muted = true; v.playsInline = true;
      v._loading = fetch(v.dataset.src!).then((r) => r.blob())
        .then((b) => { v.src = URL.createObjectURL(new Blob([b], { type: 'video/mp4' })); v.load(); })
        .catch(() => { v.src = v.dataset.src!; });
      return v._loading;
    }
    function play(v: (typeof vids)[number]) {
      if (reduce) return;
      v._want = true;
      load(v).then(() => { if (v._want) v.play().catch(() => {}); });
    }
    function stop(v: (typeof vids)[number]) {
      v._want = false; v.pause();
      try { v.currentTime = 0; } catch {}
    }
    const io = 'IntersectionObserver' in window ? new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        const v = e.target as (typeof vids)[number];
        if (e.isIntersecting) { load(v); if (!canHover) play(v); }
        else if (!canHover) { v._want = false; v.pause(); }
      });
    }, { rootMargin: '300px 0px', threshold: 0.2 }) : null;
    vids.forEach((v) => {
      if (io) io.observe(v); else load(v);
      if (canHover) {
        const card = v.closest('.defect-card') || v;
        card.addEventListener('mouseenter', () => play(v));
        card.addEventListener('mouseleave', () => stop(v));
        card.addEventListener('focusin', () => play(v));
        card.addEventListener('focusout', () => stop(v));
      }
    });
  })();

  // Перемикач «Зараз / Як має бути»
  (function () {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.diag-switch button');
    const canvas = document.getElementById('diagCanvas');
    const verdict = document.getElementById('diagVerdict');
    if (!canvas || !verdict) return;
    buttons.forEach((btn) => btn.addEventListener('click', () => {
      const after = btn.dataset.mode === 'after';
      buttons.forEach((b) => { b.classList.toggle('active', b === btn); b.setAttribute('aria-pressed', String(b === btn)); });
      canvas.classList.toggle('is-after', after);
      verdict.textContent = after ? 'ПРАЦЮЄ ЯК ГОДИННИК' : 'ПІДТІКАЄ НА КОЖНОМУ СТИКУ';
      canvas.querySelectorAll<HTMLElement>('.diag-node').forEach((node) => {
        node.querySelector('span')!.textContent = (after ? node.dataset.after : node.dataset.before) || '';
      });
    }));
  })();

  // Чек-лист симптомів + синхронізація з чіпами у формі
  (function () {
    const cards = document.querySelectorAll<HTMLElement>('.defect-card');
    const score = document.getElementById('defectScore');
    const msg = document.getElementById('defectMsg');
    const float = document.getElementById('diagFloat');
    const fScore = document.getElementById('floatScore');
    const fMsg = document.getElementById('floatMsg');
    if (!score || !msg || !float || !fScore || !fMsg) return;

    const diagnoses = [
      'Відмічайте картки — підрахуємо масштаб лиха і передамо в заявку.',
      '1 ґандж — легкий нежить. Полагодимо швидко, ще й налаштуємо профілактику.',
      '2 ґанджі — класичний старт. Уже помітно, де ви щодня втрачаєте гроші.',
      '3 ґанджі — пора на серйозний техогляд, поки бюджет не витік у пісок.',
      '4 ґанджі — маркетинг тримається на чесному слові й скотчі. Але це лікується.',
      '5 ґанджів — терміново в бокс! Тут треба перезбирати зв’язки між каналами.',
      '6 / 6 — повне бінго! Буде багато цікавої роботи.',
    ];

    function chipFor(value: string) {
      return document.querySelector<HTMLInputElement>(`#formChips input[value="${CSS.escape(value)}"]`);
    }
    function setCard(card: HTMLElement, on: boolean) {
      card.classList.toggle('selected', on);
      card.setAttribute('aria-checked', String(on));
      card.querySelector('.defect-checkbox-ui')!.textContent = on ? '✓' : '';
    }
    function render() {
      const count = document.querySelectorAll('.defect-card.selected').length;
      const word = count === 1 ? 'ґандж' : count >= 2 && count <= 4 ? 'ґанджі' : 'ґанджів';
      score!.textContent = `${count} / 6 ${word}`;
      msg!.textContent = diagnoses[count];
      fScore!.textContent = score!.textContent;
      fMsg!.textContent = diagnoses[count];
      float!.classList.toggle('has', count > 0);
      fScore!.classList.remove('pop'); void fScore!.offsetWidth; fScore!.classList.add('pop');
    }

    cards.forEach((card) => {
      const toggle = () => {
        const on = !card.classList.contains('selected');
        setCard(card, on);
        const chip = chipFor(card.dataset.defect!);
        if (chip) { chip.checked = on; chip.closest('.chip-label')?.classList.toggle('checked', on); }
        render();
      };
      card.addEventListener('click', toggle);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
      });
    });

    document.addEventListener('gandzh:chip', (e) => {
      const { value, checked } = (e as CustomEvent).detail;
      cards.forEach((card) => { if (card.dataset.defect === value) setCard(card, checked); });
      render();
    });

    // Плаваюча плашка з діагнозом
    const box = document.querySelector('.defect-counter-box');
    const section = document.getElementById('defects');
    if (!('IntersectionObserver' in window) || !box || !section) return;
    let inSection = false, boxVisible = true;
    const show = () => {
      const on = inSection && !boxVisible;
      float.classList.toggle('show', on);
      float.setAttribute('aria-hidden', on ? 'false' : 'true');
      float.querySelector('a')!.tabIndex = on ? 0 : -1;
    };
    new IntersectionObserver((e) => { boxVisible = e[0].intersectionRatio > 0.95; show(); }, { rootMargin: '-80px 0px 0px 0px', threshold: [0, 0.5, 0.95, 1] }).observe(box);
    new IntersectionObserver((e) => { inSection = e[0].isIntersecting; show(); }, { rootMargin: '-140px 0px -35% 0px' }).observe(section);
  })();
</script>
