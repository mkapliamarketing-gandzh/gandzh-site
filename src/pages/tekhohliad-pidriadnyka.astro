---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CaseCard from '../components/CaseCard.astro';

const example = await getEntry('cases', 'trekinh-pered-testom');

const faq = [
  {
    q: 'Потрібен доступ до кабінетів?',
    a: 'Так, гостьовий доступ лише на перегляд. Нічого не змінюємо без вашої згоди.',
  },
  {
    q: 'А якщо реклами немає, а є SEO-підрядник?',
    a: 'Перевіримо так само: що він робить, що з цього приходить і чи доходить до продажу.',
  },
  {
    q: 'Ви потім порадите свого підрядника?',
    a: 'Тільки якщо поточний справді не тягне. І скажемо це прямо, з аргументами.',
  },
  {
    q: 'Скільки це триває і коштує?',
    a: 'Залежить від кількості каналів і кабінетів. Називаємо термін і ціну після короткої розмови, до початку роботи.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Аудит рекламних акаунтів і роботи підрядника — Ґандж"
  description="Незалежна перевірка Google Ads, Meta та аналітики: чи доходять заявки до грошей і чи варто продовжувати з підрядником. Ми не продаємо ведення реклами."
  formTitle="Замовити техогляд"
  formLead="Напишіть, які канали і підрядники у вас зараз. Відповімо особисто, назвемо термін і ціну до початку роботи."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <PageHero
    tag="Техогляд підрядника"
    title="Аудит реклами від тих, хто не продає вам рекламу"
    lead="Агенція звітує кліками. Фрилансер каже, що треба ще місяць. А ви хочете знати одне: це окупається чи ні?"
    cta="Замовити техогляд →"
  />

  <section class="prose-section">
    <div class="container two-col">
      <div>
        <div class="section-tag">Що перевіряємо</div>
        <ul class="check-list">
          <li><b>Рекламні кабінети Google Ads і Meta:</b> структура, витрати, на що реально оптимізуються кампанії.</li>
          <li><b>Трекінг:</b> чи рахуються справжні заявки, чи дублікати й «технічні» події.</li>
          <li><b>Шлях від кліка до заявки:</b> лендинг, форма, швидкість відповіді.</li>
          <li><b>CRM:</b> чи доходять ці заявки до продажу і скільки з них у підсумку платять.</li>
          <li><b>Звіти підрядника:</b> що в них є, чого бракує.</li>
        </ul>
      </div>
      <div>
        <div class="section-tag">Що отримуєте</div>
        <p>Короткий письмовий висновок і 30-хвилинний дзвінок:</p>
        <ul class="check-list">
          <li>що працює і варто лишити;</li>
          <li>де протікають гроші і скільки приблизно;</li>
          <li>що змінити першим;</li>
          <li>чи продовжувати з поточним підрядником і що з нього вимагати.</li>
        </ul>
        <div class="note-box">
          <b>Чому ми.</b> Ми не ведемо рекламу і не беремо відсоток із рекламного бюджету. Нам не треба, щоб ви витрачали більше.
        </div>
      </div>
    </div>
  </section>

  {example && (
    <section class="cases-section">
      <div class="container">
        <div class="section-tag">Приклад</div>
        <h2 class="section-title">Іноді найкраща порада — ще не запускати</h2>
        <div class="cases-grid cases-grid--1">
          <CaseCard entry={example} index={0} />
        </div>
      </div>
    </section>
  )}

  <section class="prose-section">
    <div class="container narrow">
      <div class="section-tag">Питання</div>
      <h2 class="section-title">Часті питання</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="section-more">Техогляд — це вхідні двері. Якщо захочете йти далі, наступний крок — <a class="text-link" href="/yak-pratsiuiemo/">діагностика і супровід →</a></p>
    </div>
  </section>
</Base>
