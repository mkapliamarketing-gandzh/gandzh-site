---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CaseCard from '../components/CaseCard.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Кейси — Ґандж"
  description="Анонімні кейси з практики маркетинг-ліда в B2B: де протікали гроші, що знайшли і які рішення ухвалили. З чесними межами результату."
>
  <PageHero
    tag="Кейси"
    title="Ґанджі, які ми вже знаходили"
    lead="Кейси з практики засновниці на посаді маркетинг-ліда в B2B-компаніях. Назви не розкриваємо. Під кожним кейсом чесно пишемо, чого він не доводить."
  />
  <section class="cases-section cases-section--page">
    <div class="container">
      <div class="cases-grid cases-grid--2">
        {cases.map((entry, i) => <CaseCard entry={entry} index={i} />)}
      </div>
    </div>
  </section>
</Base>
